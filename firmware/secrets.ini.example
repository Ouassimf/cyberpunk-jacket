; Copy to secrets.ini (gitignored) and fill in. Values are compiled into the
; firmware, so the jacket_usb, jacket_ota and gledopto_ota builds pick them up.
;
; Leave wifi_ssid or ota_password empty and the firmware keeps WiFi and OTA off.
;
; Write values bare, without quotes. Spaces and most punctuation are fine, but:
;   - write a literal % as %%
;   - a space followed by ; or # starts a comment
;   - " ' \ and $ are not supported in values (they end or break the compiler
;     flag the value is passed in)
;   - ota_password: letters, digits and - _ . only. It is also passed to the
;     upload tool on a command line, where & | < > ^ and spaces break it.

[secrets]
; 2.4 GHz network the jacket joins (the ESP32 has no 5 GHz radio).
wifi_ssid = my-network
wifi_password = my-wifi-password

; Password ArduinoOTA requires before accepting an upload.
; Letters, digits and - _ . only (see above).
ota_password = choose-something-long

; Address the devkit got from the router; it is printed in the serial heartbeat.
; Used by "pio run -e jacket_ota -t upload".
ota_ip = 192.168.1.50

; Address the Gledopto controller got from the router. That board has no
; serial port: read the address from the router's list of devices (host name
; "jacket"), or from the log stream once it is known. Used by
; "pio run -e gledopto_ota -t upload". May stay empty until then.
gledopto_ip =

; For tools/deploy_via_wled.py, which updates the Gledopto through the WLED in
; its other app slot. Not compiled into anything.
; The controller's Bluetooth address (ble_check.py prints the one it finds):
gledopto_ble =
; The address or host name its WLED answers at on your network:
gledopto_wled =
