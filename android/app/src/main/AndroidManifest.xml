<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- Live mode uses them when they are there; the rest of the app works without. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- minSdk 31: scanning without deriving location, so no location permission at all. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Live mode: the phone is the jacket's microphone and motion sensor, also with the screen off.
        RECORD_AUDIO is asked for when live mode is first started with sound on; the audio is analysed in memory
        and never stored or sent. The foreground service is of type microphone (needs RECORD_AUDIO granted, and
        can therefore only start while the app is on screen) and connectedDevice (needs BLUETOOTH_CONNECT
        granted). POST_NOTIFICATIONS shows its notification with the Stop action on Android 13 and later.
        WAKE_LOCK keeps the 30 Hz stream and the accelerometer going while the screen is off.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".JacketApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jacket">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.LiveService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice" />
    </application>
</manifest>
