<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing here is worth carrying to the cloud or to another phone: the jacket holds the state. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
